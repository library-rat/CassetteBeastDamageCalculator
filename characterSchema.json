{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Characters' Stat",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "level": {"type":"integer"},
      "maxHP": { "type": "integer"},
      "mAtk": { "type": "integer"},
      "mDef": { "type": "integer"},
      "rAtk": { "type": "integer"},
      "rDef": { "type": "integer"},
      "speed": { "type": "integer"},
      "signature": { "type" :"boolean"}
    },
    "required": ["name","level","maxHP", "mAtk", "mDef", "rAtk", "rDef", "speed","signature"],
    "additionalProperties": false
  }
}
